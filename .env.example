APP_NAME="WhatsApp Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite
# For MySQL: DB_CONNECTION=mysql, DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database
# Set DB_QUEUE_RETRY_AFTER >= 180 when queue workers use timeout 90
DB_QUEUE_RETRY_AFTER=180
FILESYSTEM_DISK=local

MAIL_MAILER=log
BCRYPT_ROUNDS=12

# Safe default: no outbound WhatsApp messages.
# Enable only after configuring and testing merchant credentials.
COMMERCE_MESSAGING_DRIVER=disabled
# Trusted RelayWA origin and /api prefix; only platform operators can set this.
# RELAYWA_API_BASE_URL=https://relaywa.example.com/api
# Never commit keys or webhook signing secrets.

# Optional AI reply drafts (staff review only; never auto-send)
# COMMERCE_AI_API_KEY=
# COMMERCE_AI_MODEL=gpt-4.1-mini
